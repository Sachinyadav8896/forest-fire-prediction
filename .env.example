# Copy this file to .env and fill in real values. Never commit the real .env.
# This same file is read by docker-compose.yml for container environment variables.

# --- External APIs ---
OPENWEATHER_API_KEY=
NASA_FIRMS_API_KEY=

# --- MySQL Database ---
# In Docker Compose, DB_HOST is overridden to "mysql" (the service name) automatically.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=changeme
DB_NAME=forest_fire_db

# --- Flask ---
FLASK_DEBUG=false

# --- Email Alerts (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
