# ---------------------------------------------------------------------
# Training Dockerfile — one-off job to (re)train models and produce
# models/saved/*.joblib + research/reports + research/shap.
# Run: docker compose run --rm trainer
# ---------------------------------------------------------------------
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 gcc build-essential \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY backend/requirements.txt ./backend/requirements.txt
RUN pip install --no-cache-dir -r backend/requirements.txt

COPY config/ ./config/
COPY backend/ ./backend/
COPY dataset/ ./dataset/

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

ENTRYPOINT ["python", "backend/training/train_models.py"]
CMD ["--data", "dataset/raw/fire_data.csv", "--target", "fire_occurred"]
